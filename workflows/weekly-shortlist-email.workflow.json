{
  "id": "WeeklyShortlist01",
  "name": "Weekly shortlist -> email",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 0"
            }
          ]
        }
      },
      "name": "Sundays 10:00 Amsterdam",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "6e03ccd1-f7c5-4ee8-bae8-9663d4fa02db",
      "disabled": true
    },
    {
      "parameters": {},
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "id": "025b9af9-7ef4-4034-90d6-28101ce12921"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jobhunter-weekly-shortlist",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "responseCode": 200,
        "options": {
          "responseData": "{\"status\":\"started\"}"
        }
      },
      "name": "Webhook (manual)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        -200
      ],
      "webhookId": "001ec09a-915b-4ae1-b721-45ea226cd60c",
      "credentials": {
        "httpHeaderAuth": {
          "id": "jhWebhookToken01",
          "name": "JobHunter webhook token"
        }
      },
      "id": "54c96d06-89e7-468f-9bf4-6d5231fea018"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://job_importer:8765/weekly-digest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ days: 7 }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "name": "Build shortlist (JobImporter, read-only on JobHunter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "jiAlertsToken001",
          "name": "JobImporter alerts token"
        }
      },
      "id": "7332d2d7-1b42-4794-a158-fe3f7a6d83ba"
    },
    {
      "parameters": {
        "jsCode": "// no new jobs this week -> no email\nreturn ($json.counts && $json.counts.jobs > 0) ? [{ json: $json }] : [];"
      },
      "name": "Anything to send?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "5f865837-482e-406e-a4df-695aafc28ead"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {}
      },
      "name": "Gmail profile (who am I)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmailMeteOAuth01",
          "name": "Gmail (Mete)"
        }
      },
      "id": "872cd72d-da43-430a-99b9-3ea30fe93f48",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// SAFETY: only ever send to the Gmail account's own address (Mete himself), never to anyone else\nconst me = String($('Gmail profile (who am I)').first().json.emailAddress || '').toLowerCase();\nconst out = [];\nfor (const i of $('Anything to send?').all()) {\n  const to = String(i.json.to || '').toLowerCase();\n  if (!me || to !== me) throw new Error(`Refusing to send: recipient ${to} is not the mailbox owner`);\n  if (!i.json.raw) throw new Error('No message body');\n  out.push({ json: { raw: i.json.raw, subject: i.json.subject, job_id: i.json.job_id ?? null } });\n}\nreturn out;"
      },
      "name": "Recipient check (to = me)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "id": "f0d1265c-5331-446a-98aa-3ffd96f5d7cd"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw: $json.raw }) }}"
      },
      "name": "Send email to me",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmailMeteOAuth01",
          "name": "Gmail (Mete)"
        }
      },
      "id": "e2696b54-09ff-4e83-8a2d-d94bb08f1331"
    }
  ],
