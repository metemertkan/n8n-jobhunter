      "position": [
        960,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "jiAlertsToken001",
          "name": "JobImporter alerts token"
        }
      },
      "onError": "continueRegularOutput",
      "id": "8aaebd92-9517-43eb-8fbb-86cd9175f64d"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// attach the Gmail message id to the import outcome\nconst r = $json || {};\nreturn { json: { ...r, ok: r.ok === true, gmail_id: $('Get email').item.json.id,\n  summary: (r.jobs || []).map(j => `${j.id} ${j.outcome}`).join('; '),\n  error_text: (r.errors || []).concat(r.error ? [r.error] : []).join(' | ') } };"
      },
      "name": "Attach email id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        100
      ],
      "id": "76cc7911-5400-4167-b44f-010cb60777b1"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "All jobs handled?",
