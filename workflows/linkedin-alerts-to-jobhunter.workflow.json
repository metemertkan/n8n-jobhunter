      "parameters": {
        "jsCode": "// failed emails + the id of the 'JobHunter/import-failed' label\nconst label = ($json.labels || []).find(l => l.name === 'JobHunter/import-failed');\nif (!label) throw new Error('Gmail label JobHunter/import-failed not found');\nreturn $('All jobs handled?').all(1).map(i => ({ json: { gmail_id: i.json.gmail_id, label_id: label.id, error_text: i.json.error_text, summary: i.json.summary } }));"
      },
